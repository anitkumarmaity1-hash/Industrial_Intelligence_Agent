# Copy to .env and fill in. Never commit .env.
# Every variable app/core/config.py reads, with its default where it has one.

# --- PostgreSQL -----------------------------------------------------------
# OWNER/admin connection: alembic, scripts/*, backups, test fixtures.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/industrial_intelligence
# Phase 2 (RLS): the API connects as the least-privilege role iia_app.
# Create it with: APP_DB_PASSWORD=... python scripts/provision_app_role.py
# Unset -> the API falls back to DATABASE_URL (owner bypasses RLS: warns locally,
# refuses to start on a remote database unless RLS_REQUIRED=false).
APP_DATABASE_URL=postgresql://iia_app:CHANGE_ME@localhost:5433/industrial_intelligence
APP_DB_PASSWORD=CHANGE_ME
RLS_REQUIRED=

# docker compose only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=industrial_intelligence

# --- Security -------------------------------------------------------------
API_KEY=CHANGE_ME_LONG_RANDOM_STRING
AUTH_REQUIRED=
CORS_ALLOW_ORIGINS=
RATE_LIMIT_PER_MINUTE=30

# --- LLM / agent ----------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
GRAPH_RECURSION_LIMIT=40
GEMINI_MODEL=
GEMINI_LOCATION=global
GEMINI_SYNTHESIS_ENABLED=false
AGENTIC_ROUTING_ENABLED=
PLANNER_MODEL=

# --- RAG ------------------------------------------------------------------
RAG_BACKEND=local
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
RAG_TOP_K=
PINECONE_API_KEY=
PINECONE_INDEX=industrial-intelligence
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=maintenance-docs
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# --- Frontend -------------------------------------------------------------
API_BASE_URL=http://localhost:8000
